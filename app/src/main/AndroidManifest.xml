<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_media_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_media_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaLibrary" >
        <activity
            android:name=".home.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:theme="@style/Theme.MediaLibrary.NoActionBar"
            tools:targetApi="24" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".book.BookActivity"
            android:exported="false"
            android:label="@string/title_activity_book"
            android:parentActivityName=".home.MainActivity"
            android:resizeableActivity="true"
            android:theme="@style/Theme.MediaLibrary.NoActionBar"
            tools:targetApi="24" />
        <activity
            android:name=".book.BookFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".video.VideoActivity"
            android:exported="false"
            android:label="@string/title_activity_video"
            android:resizeableActivity="true"
            android:theme="@style/Theme.MediaLibrary.NoActionBar"
            tools:targetApi="24" />
        <activity
            android:name=".video.VideoFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".music.MusicActivity"
            android:exported="false"
            android:label="@string/title_activity_music"
            android:resizeableActivity="true"
            android:theme="@style/Theme.MediaLibrary.NoActionBar"
            tools:targetApi="24" />
        <activity
            android:name=".music.MusicFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".other.OtherActivity"
            android:exported="false"
            android:label="@string/title_activity_other"
            android:resizeableActivity="true"
            android:theme="@style/Theme.MediaLibrary.NoActionBar"
            tools:targetApi="24" />
        <activity
            android:name=".other.OtherFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>