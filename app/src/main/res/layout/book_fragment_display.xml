<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".book.ui.display.BookDisplayFragment">

    <ScrollView
        android:id="@+id/scroll_view_book_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
        <TextView
            android:id="@+id/text_display_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/book_statistics"
            android:textAppearance="?attr/textAppearanceHeadline5"
            app:layout_constraintStart_toStartOf="parent"
             />


            <TextView
                android:id="@+id/text_sheet_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/book_type_label"
                android:labelFor="@id/dropdown_sheet_type"
                android:textAppearance="?attr/textAppearanceCaption" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <AutoCompleteTextView
                    android:id="@+id/dropdown_sheet_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:id="@+id/book_total_Series_card_view"
                android:layout_width="150dp"
                android:background="@color/card"
                android:layout_height="150dp"
                android:layout_margin="16dp">

                <TextView
                    android:id="@+id/book_total_Series_card_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/card"
                    android:layout_gravity="center"
                    android:textSize="20sp"
                    android:text="@string/total_number_of_series" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/book_total_books_card_view"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@color/card"
                android:outlineSpotShadowColor="@color/primary3"
                android:outlineAmbientShadowColor="@color/primary3"
                android:layout_margin="16dp">

                <TextView
                    android:id="@+id/book_total_card_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:shadowRadius="@integer/material_motion_duration_long_1"
                    android:background="@color/card"
                    android:textSize="20sp"
                    android:text="@string/total_number_of_books" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/book_total_ongoing_card_view"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@color/card"
                    android:outlineSpotShadowColor="@color/primary3"
                    android:outlineAmbientShadowColor="@color/primary3"
                    android:layout_margin="16dp">

                    <TextView
                        android:id="@+id/book_ongoing_card_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:shadowRadius="@integer/material_motion_duration_long_1"
                        android:background="@color/card"
                        android:textSize="20sp"
                        android:text="@string/total_number_of_books" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/book_completed_card_view"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@color/card"
                    android:outlineSpotShadowColor="@color/primary3"
                    android:outlineAmbientShadowColor="@color/primary3"
                    android:layout_margin="16dp">

                    <TextView
                        android:id="@+id/book_completed_card_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:shadowRadius="@integer/material_motion_duration_long_1"
                        android:background="@color/card"
                        android:textSize="20sp"
                        android:text="" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/book_read_progress"
                    android:layout_width="match_parent"
                    android:layout_margin="16dp"
                    android:layout_height="300dp" />
            </FrameLayout>

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/book_type_bar_chart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/book_genre_pie_chart"
                android:layout_width="match_parent"
                android:background="@color/base"
                android:layout_height="300dp"
                android:layout_marginTop="16dp" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/book_publisher_bar_chart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/book_format_pie_chart"
                android:layout_width="match_parent"
                android:background="@color/base"
                android:layout_height="300dp"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/empty_state_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/empty_state_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="No Data Available"
            android:src="@drawable/ic_gallery_black_24dp"
            app:tint="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/empty_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_items_found"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>