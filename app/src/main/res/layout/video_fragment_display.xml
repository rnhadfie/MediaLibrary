<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".video.ui.display.VideoDisplayFragment">

    <LinearLayout
        android:id="@+id/top_controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/video_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/video_statistics"
                android:textAppearance="?attr/textAppearanceHeadline4"
                android:textColor="?attr/colorOnBackground" />

            <ImageButton
                android:id="@+id/sort_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sort"
                android:src="@android:drawable/ic_menu_sort_alphabetically"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/filter_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/filter"
                android:src="@drawable/ic_settings_black_24dp"
                android:tooltipText="Filter movies and tv shows"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/copy_list_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/get_list_of_items"
                android:src="@android:drawable/ic_menu_agenda"
                android:tooltipText="Get list of visible movie and tv series"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <include
            android:id="@+id/card_active_filter"
            layout="@layout/view_active_filter_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>


    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_controls_container">

        <LinearLayout
            android:id="@+id/video_stat_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/total_series_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    app:cardBackgroundColor="@color/section_video_light">

                    <TextView
                        android:id="@+id/total_series_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/total_number_of_series"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/black" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/total_video_card"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    app:cardBackgroundColor="@color/section_video_light">

                    <TextView
                        android:id="@+id/total_video_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:text="@string/total_number_of_dvds"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/black" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>


            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/watched_progress_chart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_margin="16dp" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/video_type_chart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp" />

            <include layout="@layout/view_dual_column_card"
                android:id="@+id/genre_card"
                />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/video_category_chart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/format_chart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp"
                android:background="@color/base" />
        </LinearLayout>
    </ScrollView>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/empty_state_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/top_controls_container">
            <include
                android:id="@+id/empty_state_container"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                 />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>