<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include android:id="@+id/Alphabetical"
        layout="@layout/view_filter_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/Priority"
        />
    <include android:id="@+id/Priority"
        layout="@layout/view_filter_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/Alphabetical"
        app:layout_constraintBottom_toTopOf="@id/ItemMediaType"
        />
    <include android:id="@+id/ItemMediaType"
        layout="@layout/view_filter_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/Priority"
        android:layout_marginTop="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>