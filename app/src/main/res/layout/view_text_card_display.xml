<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/table_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/template"
        android:textFontWeight="600"
        android:textSize="14sp"
        app:layout_constraintHorizontal_weight="7"
        app:layout_constraintBottom_toTopOf="@id/base_divider"
        app:layout_constraintEnd_toStartOf="@id/text_divider1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/text_divider1"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toTopOf="@id/base_divider"
        app:layout_constraintEnd_toStartOf="@id/table_valueExtra"
        app:layout_constraintStart_toEndOf="@id/table_text"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/table_valueExtra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/template"
        android:textSize="14sp"
        android:textAlignment="center"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintBottom_toTopOf="@id/base_divider"
        app:layout_constraintEnd_toStartOf="@id/text_divider2"
        app:layout_constraintStart_toEndOf="@id/text_divider1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <View
        android:id="@+id/text_divider2"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toTopOf="@id/base_divider"
        app:layout_constraintEnd_toStartOf="@id/table_value"
        app:layout_constraintStart_toEndOf="@id/table_valueExtra"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/table_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/template"
        android:textSize="14sp"
        android:textAlignment="center"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintBottom_toTopOf="@id/base_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/text_divider2"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Simplified the bottom divider from a nested layout to a single self-closing view -->
    <View
        android:id="@+id/base_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>