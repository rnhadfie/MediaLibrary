<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:label="@string/music_collection_stats"
    tools:context=".music.ui.display.MusicDisplayFragment">

    <LinearLayout
        android:id="@+id/top_controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_display_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/music_statistics"
                android:textAppearance="?attr/textAppearanceHeadline4"
                android:textColor="?attr/colorOnBackground" />

            <ImageButton
                android:id="@+id/button_filter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/filter"
                android:src="@drawable/ic_settings_black_24dp"
                android:tooltipText="Filter CDs"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/music_item_list"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/get_list_of_items"
                android:src="@android:drawable/ic_menu_agenda"
                android:tooltipText="Get list of All Cds"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <include
            android:id="@+id/card_active_filter"
            layout="@layout/view_active_filter_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_view_music_display"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_controls_container">

        <LinearLayout
            android:id="@+id/music_stats_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/music_total_items_card_view"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/card">

                <TextView
                    android:id="@+id/music_total_items_card_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/total_cds"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="@color/black" />
            </androidx.cardview.widget.CardView>

            <include layout="@layout/view_dual_column_card"
                android:id="@+id/artist_card"/>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/music_genre_pie_chart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp"
                android:background="@color/base" />




        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/empty_state_container"
        layout="@layout/view_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_controls_container" />

</androidx.constraintlayout.widget.ConstraintLayout>