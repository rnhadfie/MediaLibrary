<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_active_filter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:visibility="gone"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/filter"
            android:src="@drawable/ic_settings_black_24dp"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/text_active_filter_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorOnSurface"
            tools:text="Active Filters: Tag: Fantasy | Type: Novel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_clear_active_filter"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="8dp"
            android:text="@string/clear_filters"
            android:textColor="@color/filter_excluded"
            android:textSize="12sp"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconTint="@color/filter_excluded" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
