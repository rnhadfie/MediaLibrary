<resources>
    <!-- Base application theme (Dark Mode). -->
    <style name="Theme.MediaLibrary" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary2</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary2</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Window background & Surface -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="itemBackground">@color/dark_card</item>
        <item name="popupMenuBackground">@color/dark_surface</item>
        <item name="bottomSheetDialogTheme">@style/Theme.MediaLibrary.BottomSheetDialog</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.MediaLibrary.Button</item>
        <item name="cardViewStyle">@style/Widget.MediaLibrary.CardView</item>
    </style>

    <!-- Modern Rounded Button Style -->
    <style name="Widget.MediaLibrary.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Modern Rounded Card Style -->
    <style name="Widget.MediaLibrary.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/dark_surface</item>
    </style>

    <style name="Theme.MediaLibrary.BottomSheetDialog" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Theme.MediaLibrary.BottomSheetStyle</item>
    </style>

    <style name="Theme.MediaLibrary.BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <item name="backgroundTint">@color/dark_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MediaLibrary.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.MediaLibrary.BottomSheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.MediaLibrary.NoActionBar" parent="Theme.MediaLibrary">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MediaLibrary.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MediaLibrary.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Books Theme (Indigo) -->
    <style name="Theme.MediaLibrary.Book" parent="Theme.MediaLibrary">
        <item name="colorPrimary">@color/section_book</item>
        <item name="colorPrimaryVariant">@color/section_book_dark</item>
        <item name="colorSecondary">@color/section_book_light</item>
    </style>
    <style name="Theme.MediaLibrary.Book.NoActionBar" parent="Theme.MediaLibrary.Book">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Video Theme (Cyan) -->
    <style name="Theme.MediaLibrary.Video" parent="Theme.MediaLibrary">
        <item name="colorPrimary">@color/section_video</item>
        <item name="colorPrimaryVariant">@color/section_video_dark</item>
        <item name="colorSecondary">@color/section_video_light</item>
    </style>
    <style name="Theme.MediaLibrary.Video.NoActionBar" parent="Theme.MediaLibrary.Video">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Music Theme (Emerald) -->
    <style name="Theme.MediaLibrary.Music" parent="Theme.MediaLibrary">
        <item name="colorPrimary">@color/section_music</item>
        <item name="colorPrimaryVariant">@color/section_music_dark</item>
        <item name="colorSecondary">@color/section_music_light</item>
    </style>
    <style name="Theme.MediaLibrary.Music.NoActionBar" parent="Theme.MediaLibrary.Music">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Other Theme (Amber) -->
    <style name="Theme.MediaLibrary.Other" parent="Theme.MediaLibrary">
        <item name="colorPrimary">@color/section_other</item>
        <item name="colorPrimaryVariant">@color/section_other_dark</item>
        <item name="colorSecondary">@color/section_other_light</item>
    </style>
    <style name="Theme.MediaLibrary.Other.NoActionBar" parent="Theme.MediaLibrary.Other">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>