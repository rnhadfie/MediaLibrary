<resources>
    <!-- Base application theme. -->
    <style name="Theme.MediaLibrary" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary2</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary2</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorControlActivated">?attr/colorPrimaryVariant</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Window background & Surface -->
        <item name="android:windowBackground">@color/base</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorOnBackground">#0F172A</item>
        <item name="itemBackground">@color/secondary</item>
        <item name="popupMenuBackground">@color/secondary_light</item>
        <item name="bottomSheetDialogTheme">@style/Theme.MediaLibrary.BottomSheetDialog</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.MediaLibrary.Button</item>
        <item name="cardViewStyle">@style/Widget.MediaLibrary.CardView</item>
    </style>

    <!-- Modern Rounded Button Style -->
    <style name="Widget.MediaLibrary.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Modern Rounded Card Style -->
    <style name="Widget.MediaLibrary.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="Theme.MediaLibrary.BottomSheetDialog" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Theme.MediaLibrary.BottomSheetStyle</item>
    </style>

    <style name="Theme.MediaLibrary.BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MediaLibrary.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.MediaLibrary.BottomSheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.MediaLibrary.NoActionBar" parent="Theme.MediaLibrary">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MediaLibrary.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MediaLibrary.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.MediaLibrary.ToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:ellipsize">end</item>
    </style>

